X_CLIENT_ID=
# Add this exact callback URL to your X Developer App: https://YOUR_DOMAIN/api/auth/x/callback
X_CLIENT_SECRET=
# Use a long random value before enabling persistent signed sessions.
HOODATM_SESSION_SECRET=
HOODATM_APP_URL=https://hoodatm.online

# Writable server-only JSON registries.
# Local development defaults (relative to the app root):
#   HOODATM_PLAYER_LOG_PATH=.data/players.json
#   HOODATM_ACCESS_CODE_LOG_PATH=.data/access-codes.json
#   HOODATM_X_TOKEN_LOG_PATH=.data/x-tokens.json
# GCP VM persistent application data. Deploys must never replace these files.
HOODATM_PLAYER_LOG_PATH=/var/lib/hoodatm/players.json
HOODATM_ACCESS_CODE_LOG_PATH=/var/lib/hoodatm/access-codes.json
HOODATM_X_TOKEN_LOG_PATH=/var/lib/hoodatm/x-tokens.json

# Numeric ID of the official hoodATM launch post; enables direct Like/Retweet intents.
NEXT_PUBLIC_X_LAUNCH_POST_ID=2082123080462446795

# The live GANGSTER token and Pons liquidity pool are on Robinhood Chain mainnet.
NEXT_PUBLIC_ROBINHOOD_NETWORK=mainnet
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Production live flag. Keep false in the template; production sets true at build time.
NEXT_PUBLIC_GAME_LIVE=false
# Token is live on mainnet. Set false only to hide CA / pons / price in the top bar.
NEXT_PUBLIC_TOKEN_REVEALED=true

# Production addresses on Robinhood Chain mainnet (4663). Safe to commit — already on-chain.
NEXT_PUBLIC_HOODATM_GAME_ADDRESS=0x816848E8b84B7dc76654E46044BAc37794B132a2
NEXT_PUBLIC_HOODATM_GANG_ADDRESS=0x783566ef89251a868612C610eeD502288b0B758c
NEXT_PUBLIC_GANGSTER_ORACLE_ADDRESS=0x0cc72054CBe82e4Bba0daaBa5B7C0c4631645BB2
NEXT_PUBLIC_GANGSTER_HOLDING_ORACLE_ADDRESS=0x69156c538622b888f501d288CA9A62fc8B84132e

# Optional: skip a username lookup during follow verification.
# X_TARGET_USER_ID=

# Deployment-only address allowed to publish indexed 24-hour average balances.
HOODATM_HOLDING_ORACLE_REPORTER=
# Public resolver signer used by ATMGame and GangSystem.
NEXT_PUBLIC_HOODATM_RESOLVER_ADDRESS=0xF94EAF75197d6BA61836EF8B59256eD5C77C7F69
# Server-side resolver state only. Never prefix a signing key with NEXT_PUBLIC_.
HOODATM_RESOLVER_STATE_PATH=/var/lib/hoodatm/resolver-actions.json
# HTTPS endpoint for the isolated resolver signer. Its private key never enters the app VM.
# Local: http://127.0.0.1:8787/resolve  |  Production: https://resolver.internal/resolve
HOODATM_RESOLVER_URL=http://127.0.0.1:8787/resolve
HOODATM_RESOLVER_API_TOKEN=

# GCP systemd runtime binds Next.js to loopback behind nginx.
HOSTNAME=127.0.0.1
PORT=3000
