# Loopback-only by default. Expose via reverse proxy or private network only.
HOST=127.0.0.1
PORT=8787

# Deployed RandomnessResolver verifier contract (EIP-712 verifyingContract).
# This is NOT the signer address.
RANDOMNESS_RESOLVER_CONTRACT=

# Server-only secp256k1 private key of the authorized resolver signer.
# Must match RandomnessResolver.resolver() / NEXT_PUBLIC_HOODATM_RESOLVER_ADDRESS.
# Never commit this value. Never prefix with NEXT_PUBLIC_.
RESOLVER_PRIVATE_KEY=

# Optional shared bearer token. When set, callers must send:
#   Authorization: Bearer <token>
# Match HOODATM_RESOLVER_API_TOKEN on the Next.js app.
RESOLVER_API_TOKEN=
