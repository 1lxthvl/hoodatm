# Non-secret GCP VM configuration. Copy to
# /etc/holding-indexer/holding-indexer.env (root:root, mode 0600) and add secrets.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
DATABASE_URL=
TOKEN_ADDRESS=0x6AE32f2620A4a2B55f4Fc4b9e3152c371Aa58EF0
ORACLE_ADDRESS=
# Replace 0 with the verified GANGSTER deployment block before first backfill.
START_BLOCK=0
CONFIRMATIONS=12
BLOCK_BATCH_SIZE=2000
POLL_INTERVAL_MS=12000
ORACLE_INTERVAL_MS=3600000
ORACLE_BATCH_SIZE=200
MAX_RETRIES=5
METRICS_PORT=9460
# Keep false until backfill, 24h TWAB warmup, reporter authorization, funding,
# and a dry-run output review have passed.
SUBMIT_TRANSACTIONS=false
REPORTER_PRIVATE_KEY=
LOG_LEVEL=info
