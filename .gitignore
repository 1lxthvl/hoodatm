# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/services/**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.deploy/
/.data/
*.tar.gz
*.key
*.pem
hoodatm-backup*.json
dev-preview*.log

# Foundry build/deploy artifacts (addresses are on-chain; receipts stay local/private)
/contracts/out/
/contracts/cache/
/contracts/broadcast/
/services/**/dist

# Local operator secrets / keystores (never commit)
.hoodatm/
**/*.pass
**/randomness-resolver.env
**/holding-indexer.env

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
